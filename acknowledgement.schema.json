{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chomview.local/schemas/acknowledgement.schema.json",
  "title": "ChomView Primary Acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "type",
    "did",
    "response",
    "reason"
  ],
  "properties": {
    "protocol": {
      "const": "BROTLI/1"
    },
    "type": {
      "const": "ack"
    },
    "did": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "response": {
      "enum": [
        "ADOPT",
        "ADAPT",
        "DECLINE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "pattern": {
      "type": "string",
      "maxLength": 1200
    },
    "changed_rule": {
      "type": "string",
      "maxLength": 1200
    },
    "rule_id": {
      "type": "string",
      "maxLength": 200
    },
    "continuity_action": {
      "enum": [
        "NONE",
        "REMEMBER",
        "RECORD_RECURRENCE",
        "RESOLVE_AFTER_EVIDENCE"
      ]
    }
  }
}
