{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chomview.local/schemas/behavioral-contract.schema.json",
  "title": "ChomView Behavioral Compatibility Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "default_decision",
    "principles",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "default_decision": {
      "enum": [
        "ALLOW",
        "LOOK_AGAIN",
        "REQUIRE_CONSENT",
        "BLOCK"
      ]
    },
    "principles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_regex": {
          "type": "string",
          "maxLength": 1000
        },
        "tool": {
          "type": "string",
          "maxLength": 1000
        },
        "input_regex": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "minProperties": 1
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "enabled",
        "priority",
        "decision",
        "authority",
        "stakeholders",
        "resources",
        "rationale",
        "matchers"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "decision": {
          "enum": [
            "ALLOW",
            "LOOK_AGAIN",
            "REQUIRE_CONSENT",
            "BLOCK"
          ]
        },
        "authority": {
          "enum": [
            "CAN_EXECUTE",
            "CAN_PROPOSE",
            "REQUIRES_OWNER_CONSENT",
            "DENY_EXECUTION"
          ]
        },
        "stakeholders": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "matchers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/matcher"
          }
        }
      }
    }
  }
}
