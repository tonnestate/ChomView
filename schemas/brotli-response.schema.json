{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chomview.local/schemas/brotli-response.schema.json",
  "title": "ChomView BROTLI/1 Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "type", "reply_to", "did", "stance", "concern", "missing", "chain", "advice", "check", "why", "confidence"],
  "properties": {
    "protocol": {"const": "BROTLI/1"},
    "type": {"const": "response"},
    "reply_to": {"type": "string", "minLength": 1, "maxLength": 160},
    "did": {"type": "string", "minLength": 1, "maxLength": 160},
    "stance": {"enum": ["OK", "LOOK_AGAIN", "WARNING"]},
    "concern": {"enum": ["NONE", "LOW", "MATERIAL", "HIGH"]},
    "missing": {"type": "string", "maxLength": 1600},
    "chain": {"type": "string", "maxLength": 1600},
    "advice": {"type": "string", "minLength": 1, "maxLength": 1800},
    "check": {"type": "string", "maxLength": 1600},
    "insufficient": {"type": "string", "maxLength": 1200},
    "why": {"type": "string", "maxLength": 1200},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
  }
}
